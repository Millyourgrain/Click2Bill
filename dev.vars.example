# Copy to ".dev.vars" for `npx wrangler dev` (same folder as wrangler.toml).
# ".dev.vars" is gitignored — do not commit secrets.
#
# FIREBASE_API_KEY must match VITE_FIREBASE_API_KEY in .env (same Firebase Web API key).

FIREBASE_API_KEY=
RESEND_API_KEY=

# Sender address — domain must be verified in Resend first.
# For local dev you can leave as-is (uses Resend's onboarding address as fallback).
FROM_EMAIL=Click2Bill <invoices@click2bill.ca>

# Reply-To address — customer replies land here.
# Set up click2bill.ca email forwarding: support@click2bill.ca → click2Bill.ca@gmail.com
REPLY_TO_EMAIL=Click2Bill Support <support@click2bill.ca>
