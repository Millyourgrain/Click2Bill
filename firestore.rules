// =====================================================================
// FIREBASE FIRESTORE RULES - E-Invoicing Platform (PSW / Service Worker)
// =====================================================================
//
// HOW TO APPLY:
// Firebase Console → Firestore Database → Rules → replace all → Publish
//
// Collections: users, companies, customers, visits, invoices, travelRecords,
//              invoiceDeletions, customerProfiles, notifications
//
// Customers (payors) primarily use the email link (/invoice/view?…t=…): Firestore allows
// get on invoices that have portalToken, and guest updates only for accept / contest / view / pay fields.
// Logged-in customers with matching customerEmail/payorEmail may still read/update those invoices.
//
// Maker–checker (companies.invoiceSystem == "maker_checker"): invoice creates and broad updates require
// canActAsInvoiceMaker (billing owner, maker, or org admin — not checker). Pure checkers may only patch
// checker-whitelisted fields (portal/reminders, signatory while pending_checker, approve, or issue).
// If status == contested, org workers may update only when canMcAdminOrBillingOwner (billing owner
// or userTeamRole admin; legacy admin_checker treated). Deletes require billing owner or admin.
// Checker (non-maker) may set approvalState returned_to_maker + checkerRecommendation to send a draft back.
//
// =====================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Team member: organizationOwnerId on users/{uid} points to org billing uid (company owner).
    function isOrgTeamMemberFor(billingUserId) {
      return request.auth != null && (
        request.auth.uid == billingUserId
        || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationOwnerId == billingUserId
        )
      );
    }

    // Guest with secret link: ?t= must match stored portalToken in app; read allowed only if invoice was issued with a portal token.
    function invoicePortalGuestUpdateOk() {
      return request.auth == null
        && resource.data.portalToken is string
        && resource.data.portalToken.size() >= 16
        && request.resource.data.portalToken == resource.data.portalToken
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.invoiceNumber == resource.data.invoiceNumber
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'viewedAt', 'acceptedAt', 'customerCommentary', 'paidAt', 'paymentReference', 'updatedAt']);
    }

    function userDocExists() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userTeamRole() {
      return (userDocExists() && 'userTeamRole' in userData() && userData().userTeamRole is string)
        ? userData().userTeamRole
        : '';
    }

    function hasOrgOwnerBinding() {
      return userDocExists()
        && 'organizationOwnerId' in userData()
        && userData().organizationOwnerId is string
        && userData().organizationOwnerId.size() > 0;
    }

    // Mirrors workerOrgContext.getWorkerDashboardPersona (userTeamRole stored lowercase in app).
    function dashboardPersona() {
      return hasOrgOwnerBinding() ? invitedPersona() : ownerPersona();
    }

    function invitedPersona() {
      let r = userTeamRole();
      return r == 'admin' || r == 'admin_checker' ? 'org_admin'
        : r == 'checker' ? 'checker'
        : r == 'maker' ? 'maker'
        : 'maker';
    }

    function ownerPersona() {
      let r = userTeamRole();
      return r == '' ? 'org_admin'
        : r == 'admin' || r == 'admin_checker' ? 'org_admin'
        : r == 'checker' ? 'checker'
        : r == 'maker' ? 'maker'
        : 'org_admin';
    }

    function canActAsInvoiceMaker() {
      let p = dashboardPersona();
      return p != 'checker';
    }

    function canActAsInvoiceChecker() {
      let p = dashboardPersona();
      return p == 'checker' || p == 'org_admin';
    }

    function orgInvoiceSystemSafe(billingUserId) {
      return (
          exists(/databases/$(database)/documents/companies/$(billingUserId))
          && 'invoiceSystem' in get(/databases/$(database)/documents/companies/$(billingUserId)).data
          && get(/databases/$(database)/documents/companies/$(billingUserId)).data.invoiceSystem is string
        )
        ? get(/databases/$(database)/documents/companies/$(billingUserId)).data.invoiceSystem
        : '';
    }

    function invoiceCreateMcOk(billingUserId) {
      return orgInvoiceSystemSafe(billingUserId) != 'maker_checker'
        || !userDocExists()
        || canActAsInvoiceMaker();
    }

    // Checker: limited patches; billing owner, org admin & makers get full access via canActAsInvoiceMaker.
    function invoiceMcCheckerOnlyPatchOk() {
      let billingUid = resource.data.userId;
      let d = request.resource.data.diff(resource.data).affectedKeys();
      let meta = d.hasOnly(['portalToken', 'reminderEnabled', 'reminderFrequency', 'updatedAt', 'lastUpdatedByUid']);
      let sign = resource.data.approvalState == 'pending_checker'
        && d.hasOnly([
          'signature',
          'signatoryTitle',
          'signatoryPrintedName',
          'signatorySignedAt',
          'reminderEnabled',
          'reminderFrequency',
          'updatedAt',
          'lastUpdatedByUid',
        ]);
      let approve = d.hasOnly(['approvalState', 'checkerApprovedAt', 'updatedAt', 'lastUpdatedByUid']);
      let issue = d.hasOnly(['status', 'approvalState', 'issuedAt', 'portalToken', 'updatedAt', 'lastUpdatedByUid']);
      let returnToMaker = resource.data.approvalState == 'pending_checker'
        && request.resource.data.approvalState == 'returned_to_maker'
        && request.resource.data.status == resource.data.status
        && request.resource.data.checkerRecommendation is string
        && request.resource.data.checkerRecommendation.size() > 0
        && request.resource.data.checkerRecommendation.size() <= 8000
        && request.resource.data.returnedToMakerAt is string
        && d.hasOnly([
          'approvalState',
          'checkerRecommendation',
          'returnedToMakerAt',
          'updatedAt',
          'lastUpdatedByUid',
        ]);
      let isMc = orgInvoiceSystemSafe(billingUid) == 'maker_checker';
      let isCheckerOnly = userDocExists() && canActAsInvoiceChecker() && !canActAsInvoiceMaker();
      return isMc && isCheckerOnly && (meta || sign || approve || issue || returnToMaker);
    }

    function invoiceWorkerMcUpdateOk() {
      let billingUid = resource.data.userId;
      let mc = orgInvoiceSystemSafe(billingUid) == 'maker_checker';
      let contested = resource.data.status == 'contested';
      // Contested (MC): only billing owner or org admin (legacy admin_checker) — not maker or checker alone.
      return (mc && contested)
        ? (!userDocExists() || canMcAdminOrBillingOwner(billingUid))
        : (
            orgInvoiceSystemSafe(billingUid) != 'maker_checker'
            || !userDocExists()
            || canActAsInvoiceMaker()
            || invoiceMcCheckerOnlyPatchOk()
          );
    }

    function invoiceCustomerRecipientUpdateOk() {
      return request.resource.data.userId == resource.data.userId
        && request.resource.data.invoiceNumber == resource.data.invoiceNumber
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'viewedAt', 'acceptedAt', 'customerCommentary', 'paidAt', 'paymentReference', 'updatedAt']);
    }

    function canMcAdminOrBillingOwner(billingUserId) {
      return request.auth.uid == billingUserId
        || userTeamRole() == 'admin'
        || userTeamRole() == 'admin_checker';
    }

    function invoiceDeletionCreateMcOk(billingUserId) {
      return orgInvoiceSystemSafe(billingUserId) != 'maker_checker'
        || !userDocExists()
        || canMcAdminOrBillingOwner(billingUserId);
    }

    function invoiceDeleteMcOk(billingUserId) {
      return orgInvoiceSystemSafe(billingUserId) != 'maker_checker'
        || !userDocExists()
        || canMcAdminOrBillingOwner(billingUserId);
    }

    // -------------------------------------------------------------------
    // USERS - Auth user profiles (role, email, etc.)
    // Used by: authService, notificationService (getUserIdByEmail)
    // -------------------------------------------------------------------
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }

    // -------------------------------------------------------------------
    // COMPANIES - Worker/agency profile (one doc per user, docId = userId)
    // Used by: companyService
    // -------------------------------------------------------------------
    match /companies/{companyId} {
      // Owner: full access. Team member (maker/checker): read org company when users/{uid}.organizationOwnerId matches.
      allow read: if request.auth != null && (
        companyId == request.auth.uid
        || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizationOwnerId == companyId
        )
      );
      allow update: if request.auth != null && isOrgTeamMemberFor(companyId);
      allow delete: if request.auth != null && companyId == request.auth.uid;
      allow create: if request.auth != null && companyId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    // -------------------------------------------------------------------
    // CUSTOMERS - Worker's customer records
    // Used by: customerService
    // -------------------------------------------------------------------
    match /customers/{docId} {
      allow read, update, delete: if request.auth != null && isOrgTeamMemberFor(resource.data.userId);
      allow create: if request.auth != null && isOrgTeamMemberFor(request.resource.data.userId);
    }

    // -------------------------------------------------------------------
    // VISITS - Service scheduling (check-in/check-out)
    // Used by: visitService
    // -------------------------------------------------------------------
    match /visits/{docId} {
      allow read, update, delete: if request.auth != null && isOrgTeamMemberFor(resource.data.userId);
      allow create: if request.auth != null && isOrgTeamMemberFor(request.resource.data.userId);
    }

    // -------------------------------------------------------------------
    // INVOICES - Worker creates; Customer/Payor can read & update (accept/contest/pay)
    // Used by: invoiceService
    // Maker–checker: create + broad update/delete require maker/admin/billing owner (see invoiceCreateMcOk,
    // invoiceWorkerMcUpdateOk, invoiceDeleteMcOk). Checkers get checker-only field sets (invoiceMcCheckerOnlyPatchOk).
    // -------------------------------------------------------------------
    match /invoices/{docId} {
      allow create: if request.auth != null
        && isOrgTeamMemberFor(request.resource.data.userId)
        && invoiceCreateMcOk(request.resource.data.userId);
      allow get: if (request.auth != null && (
          isOrgTeamMemberFor(resource.data.userId)
          || resource.data.customerEmail == request.auth.token.email
          || resource.data.payorEmail == request.auth.token.email
        ))
        || (resource.data.portalToken is string && resource.data.portalToken.size() >= 16);
      allow list: if request.auth != null;
      // Org workers first (may use fields not allowed to customers, e.g. paymentMethod).
      allow update: if invoicePortalGuestUpdateOk()
        || (request.auth != null
          && isOrgTeamMemberFor(resource.data.userId)
          && request.resource.data.userId == resource.data.userId
          && invoiceWorkerMcUpdateOk())
        || (request.auth != null
          && resource.data.customerEmail == request.auth.token.email
          && !isOrgTeamMemberFor(resource.data.userId)
          && invoiceCustomerRecipientUpdateOk())
        || (request.auth != null
          && resource.data.payorEmail == request.auth.token.email
          && !isOrgTeamMemberFor(resource.data.userId)
          && invoiceCustomerRecipientUpdateOk());
      allow delete: if request.auth != null
        && isOrgTeamMemberFor(resource.data.userId)
        && invoiceDeleteMcOk(resource.data.userId);
    }

    // -------------------------------------------------------------------
    // TRAVEL RECORDS - Worker's business travel records
    // Used by: travelRecordService
    // -------------------------------------------------------------------
    match /travelRecords/{docId} {
      allow read, update, delete: if request.auth != null && isOrgTeamMemberFor(resource.data.userId);
      allow create: if request.auth != null && isOrgTeamMemberFor(request.resource.data.userId);
    }

    // -------------------------------------------------------------------
    // CUSTOMER PROFILES - Customer/Payor platform profile (docId = userId)
    // Used by: customerProfileService
    // -------------------------------------------------------------------
    match /customerProfiles/{profileId} {
      allow read, update, delete: if request.auth != null && profileId == request.auth.uid;
      allow create: if request.auth != null && profileId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }

    // -------------------------------------------------------------------
    // NOTIFICATIONS - User notifications (check-in, invoice viewed, etc.)
    // Used by: notificationService
    // Workers create for customers; users read their own
    // -------------------------------------------------------------------
    match /notifications/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // -------------------------------------------------------------------
    // INVOICE DELETION AUDIT - written before invoice doc is deleted
    // -------------------------------------------------------------------
    match /invoiceDeletions/{docId} {
      allow create: if request.auth != null
        && isOrgTeamMemberFor(request.resource.data.billingUserId)
        && invoiceDeletionCreateMcOk(request.resource.data.billingUserId);
      allow read: if request.auth != null && isOrgTeamMemberFor(resource.data.billingUserId);
      allow update, delete: if false;
    }

  }
}
